{
	"name": "n8n-nodes-bundlesocial",
	"version": "1.0.0",
	"description": "n8n node for bundle.social: schedule posts, manage uploads, comments, DMs, automations and analytics across 15 social networks. Unlimited social accounts.",
	"license": "MIT",
	"homepage": "https://bundle.social",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"bundle.social",
		"social media",
		"scheduling",
		"instagram",
		"tiktok",
		"youtube",
		"linkedin"
	],
	"author": {
		"name": "bundle.global",
		"email": "marcel@bundle.global"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bundleglobal/bundlesocial-n8n.git"
	},
	"bugs": {
		"url": "https://github.com/bundleglobal/bundlesocial-n8n/issues"
	},
	"scripts": {
		"fetch-openapi": "curl -fsSL https://api.bundle.social/swagger-json -o openapi/bundlesocial.openapi.json",
		"generate": "node scripts/generate.mjs",
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"typecheck": "tsc --noEmit",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "npm run build && vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "npm run lint && npm run build"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"provenance": true
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/BundleSocialApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/BundleSocial/BundleSocial.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.53.2",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"semantic-release": "^25.0.2",
		"typescript": "5.9.3",
		"vitest": "^2.0.5"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
