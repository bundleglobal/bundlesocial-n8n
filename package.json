{
	"name": "n8n-nodes-bundlesocial",
	"version": "0.1.0",
	"description": "n8n node for bundle.social: schedule posts, manage uploads, comments, DMs, automations and analytics across 15 social networks. Unlimited social accounts.",
	"license": "MIT",
	"homepage": "https://bundle.social",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"bundle.social",
		"social media",
		"scheduling",
		"instagram",
		"tiktok",
		"youtube",
		"linkedin"
	],
	"author": {
		"name": "bundle.social",
		"email": "marcel@bundle.global"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/bundleglobal/n8n-nodes-bundlesocial.git"
	},
	"scripts": {
		"generate": "node scripts/generate.mjs",
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "npm run build && node --test test/*.test.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/BundleSocialApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/BundleSocial/BundleSocial.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.53.2",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
